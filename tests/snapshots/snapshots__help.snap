---
source: tests/snapshots.rs
expression: v
---
{
  "about": "Hallmark: agentic development · automated review · a full record",
  "commands": [
    {
      "about": "Set up this repository: .hallmark.toml, journal, CLAUDE.md section",
      "args": [
        {
          "help": "How the edit gate treats edits outside an item's worktree",
          "name": "capture",
          "required": false,
          "syntax": "--capture <capture>",
          "takes_value": true,
          "values": [
            "gate",
            "ask",
            "off"
          ]
        },
        {
          "help": "The base branch (detected when omitted)",
          "name": "base",
          "required": false,
          "syntax": "--base <base>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Don't add the Hallmark section to CLAUDE.md or AGENTS.md",
          "name": "no_claude_md",
          "required": false,
          "syntax": "--no-claude-md",
          "takes_value": false
        }
      ],
      "name": "init",
      "schema": "hall schema init",
      "usage": "hall init [OPTIONS]"
    },
    {
      "about": "Check the install and name the fix for each problem",
      "args": [],
      "name": "doctor",
      "schema": "hall schema doctor",
      "usage": "hall doctor [OPTIONS]"
    },
    {
      "about": "Create an item and its worktree",
      "args": [
        {
          "help": "The request, in your words. Becomes the first journal entry. The Front Desk splits it into parallel parts when it can",
          "name": "request",
          "required": false,
          "syntax": "<request>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Never split the request into parallel parts",
          "name": "no_split",
          "required": false,
          "syntax": "--no-split",
          "takes_value": false
        },
        {
          "help": "Make this item a parallel part of another item (merges into it)",
          "name": "parent",
          "required": false,
          "syntax": "--parent <parent>",
          "takes_value": true
        },
        {
          "help": "Start from feedback on a shipped PR (a URL or number)",
          "name": "follow_up",
          "required": false,
          "syntax": "--follow-up <follow_up>",
          "takes_value": true
        },
        {
          "help": "A short title (defaults to the request or the issue title)",
          "name": "title",
          "required": false,
          "syntax": "--title <title>",
          "takes_value": true
        },
        {
          "help": "Start from a GitHub issue (uses gh)",
          "name": "issue",
          "required": false,
          "syntax": "--issue <issue>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Open Claude Code in the new worktree (on a terminal)",
          "name": "open",
          "required": false,
          "syntax": "--open",
          "takes_value": false
        },
        {
          "help": "Override the branch name",
          "name": "branch",
          "required": false,
          "syntax": "--branch <branch>",
          "takes_value": true
        }
      ],
      "name": "new",
      "schema": "hall schema new",
      "usage": "hall new [OPTIONS] [REQUEST]"
    },
    {
      "about": "Turn the current branch, or an open PR, into an item; reopens a shipped one",
      "args": [
        {
          "name": "title",
          "required": false,
          "syntax": "--title <title>",
          "takes_value": true
        },
        {
          "help": "Take over an open PR (a URL or number), Hallmark's or not: its branch is checked out in a worktree if none has it, and the item updates the PR instead of opening one. A PR Hallmark shipped reopens its item",
          "name": "pr",
          "required": false,
          "syntax": "--pr <pr>",
          "takes_value": true
        },
        {
          "help": "The branch to review against and target, to stack the item on another PR (default: the PR's base, else the configured base)",
          "name": "base",
          "required": false,
          "syntax": "--base <base>",
          "takes_value": true
        }
      ],
      "name": "adopt",
      "schema": "hall schema adopt",
      "usage": "hall adopt [OPTIONS]"
    },
    {
      "about": "Items by state, or one item in detail",
      "args": [
        {
          "help": "An item ID; omit to list items (or inside a worktree, its item)",
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Include closed and dropped items",
          "name": "all",
          "required": false,
          "syntax": "--all",
          "takes_value": false
        }
      ],
      "name": "status",
      "schema": "hall schema status",
      "usage": "hall status [OPTIONS] [ID]"
    },
    {
      "about": "An item's journal",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "Only these events (comma-separated): prompt, commit, ready, verdict… `review` means verdict",
          "name": "kind",
          "required": false,
          "syntax": "--kind <kind>",
          "takes_value": true
        },
        {
          "help": "Only the last N events",
          "name": "limit",
          "required": false,
          "syntax": "--limit <limit>",
          "takes_value": true
        }
      ],
      "name": "log",
      "schema": "hall schema log",
      "usage": "hall log [OPTIONS] [ID]"
    },
    {
      "about": "Everything waiting for you, oldest first; `hall inbox <n>` explains one, `--dismiss` hides it and `--clear` hides them all",
      "args": [
        {
          "help": "One entry to explain: its number in the list, a question ID (Q-3) or an item ID",
          "name": "entry",
          "required": false,
          "syntax": "<entry>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Dismiss that entry: it stays hidden until it changes. Nothing is answered, retried or dropped",
          "name": "dismiss",
          "required": false,
          "syntax": "--dismiss",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "Dismiss every entry shown now",
          "name": "clear",
          "required": false,
          "syntax": "--clear",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "Show dismissed entries too",
          "name": "all",
          "required": false,
          "syntax": "--all",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "List notices instead: what the loop is handling on its own, or news (stuck items, waiting sessions, CI being fixed, proposed learnings). They never reach your office and are never notified",
          "name": "notices",
          "required": false,
          "syntax": "--notices",
          "takes_value": false
        }
      ],
      "name": "inbox",
      "schema": "hall schema inbox",
      "usage": "hall inbox [OPTIONS] [ENTRY]"
    },
    {
      "about": "Follow an item live until it leaves the loop or needs you",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "default": "30m",
          "help": "Stop watching after this long, such as 30m",
          "name": "timeout",
          "required": false,
          "syntax": "--timeout <timeout>",
          "takes_value": true
        }
      ],
      "name": "watch",
      "schema": "hall schema watch",
      "usage": "hall watch [OPTIONS] [ID]"
    },
    {
      "about": "Freeze the commit and send the item to review",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "A note for the reviewer and the journal",
          "name": "note",
          "required": false,
          "syntax": "--note <note>",
          "takes_value": true
        }
      ],
      "name": "ready",
      "schema": "hall schema ready",
      "usage": "hall ready [OPTIONS] [ID]"
    },
    {
      "about": "Stop review and return the item to development",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "name": "reason",
          "required": false,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "pull-back",
      "schema": "hall schema pull-back",
      "usage": "hall pull-back [OPTIONS] [ID]"
    },
    {
      "about": "Abandon an item, keeping its journal and branch",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "Why it's dropped. Required",
          "name": "reason",
          "required": true,
          "syntax": "--reason <reason>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Keep the worktree on disk",
          "name": "keep_worktree",
          "required": false,
          "syntax": "--keep-worktree",
          "takes_value": false
        }
      ],
      "name": "drop",
      "schema": "hall schema drop",
      "usage": "hall drop [OPTIONS] --reason <REASON> [ID]"
    },
    {
      "about": "Allow another fix round for an escalated item, or release a held one. A budget hold also grants the item more tokens; the budget itself is unchanged",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "name": "reason",
          "required": true,
          "syntax": "--reason <reason>",
          "takes_value": true
        },
        {
          "help": "For a budget hold: how many more tokens this item may spend, such as 2M or 800k. Defaults to another `per_item`",
          "name": "tokens",
          "required": false,
          "syntax": "--tokens <tokens>",
          "takes_value": true
        }
      ],
      "name": "retry",
      "schema": "hall schema retry",
      "usage": "hall retry [OPTIONS] --reason <REASON> [ID]"
    },
    {
      "about": "Move an item on from wherever it waits: release a hold, retry an escalation, send it to review, or reopen its Claude session",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "Why (recorded when it releases a hold or retries an escalation)",
          "name": "reason",
          "required": false,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "continue",
      "schema": "hall schema continue",
      "usage": "hall continue [OPTIONS] [ID]"
    },
    {
      "about": "The dev agent says the work looks done (moves it to Awaiting you)",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "What was done, for the human deciding. It becomes the What of the PR description",
          "name": "summary",
          "required": true,
          "syntax": "--summary <summary>",
          "takes_value": true
        },
        {
          "help": "Why the change is needed: the PR description's Why. Without it, the request (or the issue) is used",
          "name": "why",
          "required": false,
          "syntax": "--why <why>",
          "takes_value": true
        },
        {
          "help": "How it was done: the approach and the notable choices, for the PR description's How. Without it, the commits are listed",
          "name": "how",
          "required": false,
          "syntax": "--how <how>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Something needs the human's confirmation: wait for their call instead of going straight to review",
          "name": "ask",
          "required": false,
          "syntax": "--ask",
          "takes_value": false
        }
      ],
      "name": "propose-ready",
      "schema": "hall schema propose-ready",
      "usage": "hall propose-ready [OPTIONS] --summary <SUMMARY> [ID]"
    },
    {
      "about": "Ask the human a question; it lands in the inbox",
      "args": [
        {
          "name": "question",
          "required": true,
          "syntax": "<question>",
          "takes_value": true
        },
        {
          "help": "The item it's about (defaults to the current worktree's item)",
          "name": "item",
          "required": false,
          "syntax": "--item <item>",
          "takes_value": true
        },
        {
          "help": "Allowed answers, comma-separated. Answer with the text or a letter",
          "name": "options",
          "required": false,
          "syntax": "--options <options>",
          "takes_value": true
        },
        {
          "help": "Used if nobody answers within --wait",
          "name": "default",
          "required": false,
          "syntax": "--default <default>",
          "takes_value": true
        },
        {
          "help": "How long to wait for an answer, such as 4h",
          "name": "wait",
          "required": false,
          "syntax": "--wait <wait>",
          "takes_value": true
        },
        {
          "help": "The Claude Code session to resume with the answer",
          "name": "session",
          "required": false,
          "syntax": "--session <session>",
          "takes_value": true
        }
      ],
      "name": "ask",
      "schema": "hall schema ask",
      "usage": "hall ask [OPTIONS] <QUESTION>"
    },
    {
      "about": "Answer a question from the inbox",
      "args": [
        {
          "help": "The question ID, such as Q-12",
          "name": "qid",
          "required": true,
          "syntax": "<qid>",
          "takes_value": true
        },
        {
          "help": "An option's text or letter (a, b, …), or free text",
          "name": "answer",
          "required": true,
          "syntax": "<answer>",
          "takes_value": true
        }
      ],
      "name": "answer",
      "schema": "hall schema answer",
      "usage": "hall answer [OPTIONS] <QID> <ANSWER>"
    },
    {
      "about": "Tokens and list-price cost, grouped",
      "args": [
        {
          "default": "room",
          "name": "by",
          "required": false,
          "syntax": "--by <by>",
          "takes_value": true,
          "values": [
            "item",
            "room",
            "role",
            "model",
            "day",
            "source"
          ]
        },
        {
          "help": "Only usage newer than this, such as 7d or 24h",
          "name": "since",
          "required": false,
          "syntax": "--since <since>",
          "takes_value": true
        },
        {
          "name": "item",
          "required": false,
          "syntax": "--item <item>",
          "takes_value": true
        }
      ],
      "name": "usage",
      "schema": "hall schema usage",
      "usage": "hall usage [OPTIONS]"
    },
    {
      "about": "Rebuild the SQLite index from the journal",
      "args": [
        {
          "default": "false",
          "help": "Rebuild even when a newer hall owns the index, and take it over",
          "name": "force",
          "required": false,
          "syntax": "--force",
          "takes_value": false
        }
      ],
      "name": "reindex",
      "schema": "hall schema reindex",
      "usage": "hall reindex [OPTIONS]"
    },
    {
      "about": "Commands, arguments, exit codes and error codes",
      "args": [
        {
          "help": "Help for one command",
          "name": "command",
          "required": false,
          "syntax": "<command>",
          "takes_value": true
        }
      ],
      "name": "help",
      "schema": "hall schema help",
      "usage": "hall help [OPTIONS] [COMMAND]"
    },
    {
      "about": "The JSON Schema of a command's output (or error, event, config)",
      "args": [
        {
          "help": "A command name, or error, event, config, item",
          "name": "name",
          "required": false,
          "syntax": "<name>",
          "takes_value": true
        }
      ],
      "name": "schema",
      "schema": "hall schema schema",
      "usage": "hall schema [OPTIONS] [NAME]"
    },
    {
      "about": "Entry point for Claude Code hooks; reads the hook JSON on stdin",
      "args": [
        {
          "name": "event",
          "required": true,
          "syntax": "<event>",
          "takes_value": true,
          "values": [
            "session-start",
            "user-prompt-submit",
            "pre-tool-use",
            "post-tool-use",
            "stop",
            "notification"
          ]
        }
      ],
      "name": "hook",
      "schema": "hall schema hook",
      "usage": "hall hook [OPTIONS] <EVENT>"
    },
    {
      "about": "One-time machine setup",
      "args": [
        {
          "help": "Only this part. Without one, `hall setup` does everything: the Claude Code plugin and status line, this repo, the daemon at login, a phone topic, then `hall doctor`. Safe to repeat; re-run it after upgrading hall",
          "name": "target",
          "required": false,
          "syntax": "<target>",
          "takes_value": true,
          "values": [
            "claude"
          ]
        },
        {
          "default": "false",
          "help": "Print what would be done without doing it",
          "name": "dry_run",
          "required": false,
          "syntax": "--dry-run",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "Also set Claude Code's status line to `hall statusline` in ~/.claude/settings.json",
          "name": "statusline",
          "required": false,
          "syntax": "--statusline",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "Replace a status line that isn't Hallmark's",
          "name": "force",
          "required": false,
          "syntax": "--force",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "`hall setup`: leave Claude Code's status line alone",
          "name": "no_statusline",
          "required": false,
          "syntax": "--no-statusline",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "`hall setup`: don't start the daemon or install its login service",
          "name": "no_daemon",
          "required": false,
          "syntax": "--no-daemon",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "`hall setup`: don't create a phone topic",
          "name": "no_notify",
          "required": false,
          "syntax": "--no-notify",
          "takes_value": false
        },
        {
          "default": "false",
          "help": "`hall setup`: ask about every setting first: base branch, gates and the shell they run in, how work is shipped, models, budget, tools and notifications. Needs a terminal; `hall config` sets the same keys without questions",
          "name": "interactive",
          "required": false,
          "syntax": "--interactive",
          "takes_value": false
        }
      ],
      "name": "setup",
      "schema": "hall schema setup",
      "usage": "hall setup [OPTIONS] [TARGET]"
    },
    {
      "about": "Read and change settings: this repo's .hallmark.toml, or your user config (tools, notifications) with --user. `hall config list` shows every key with its value and where it comes from",
      "args": [],
      "name": "config",
      "schema": "hall schema config-reply",
      "usage": "hall config [OPTIONS] [COMMAND]"
    },
    {
      "about": "Every key with its value and where it comes from (default, repo, user, env, path)",
      "args": [
        {
          "help": "Only keys under this prefix, such as `budget` or `notify.route`",
          "name": "prefix",
          "required": false,
          "syntax": "<prefix>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Your user config instead of the repo's",
          "name": "user",
          "required": false,
          "syntax": "--user",
          "takes_value": false
        }
      ],
      "name": "config list",
      "schema": "hall schema config-reply",
      "usage": "hall config list [OPTIONS] [PREFIX]"
    },
    {
      "about": "One key's value",
      "args": [
        {
          "help": "A dotted key, such as `budget.daily`",
          "name": "key",
          "required": true,
          "syntax": "<key>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Your user config instead of the repo's",
          "name": "user",
          "required": false,
          "syntax": "--user",
          "takes_value": false
        }
      ],
      "name": "config get",
      "schema": "hall schema config-reply",
      "usage": "hall config get [OPTIONS] <KEY>"
    },
    {
      "about": "Set a key; the file's comments and layout are kept. A list takes several values, or one TOML array ('[\"a\", \"b\"]')",
      "args": [
        {
          "help": "A dotted key, such as `budget.daily` or `tools.gh`",
          "name": "key",
          "required": true,
          "syntax": "<key>",
          "takes_value": true
        },
        {
          "help": "The value. Put `--` before values that start with `-`",
          "name": "value",
          "required": true,
          "syntax": "<value>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Your user config instead of the repo's (`tools.*` is always there)",
          "name": "user",
          "required": false,
          "syntax": "--user",
          "takes_value": false
        }
      ],
      "name": "config set",
      "schema": "hall schema config-reply",
      "usage": "hall config set [OPTIONS] <KEY> <VALUE>..."
    },
    {
      "about": "Remove a key, so its default applies again",
      "args": [
        {
          "help": "A dotted key",
          "name": "key",
          "required": true,
          "syntax": "<key>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Your user config instead of the repo's",
          "name": "user",
          "required": false,
          "syntax": "--user",
          "takes_value": false
        }
      ],
      "name": "config unset",
      "schema": "hall schema config-reply",
      "usage": "hall config unset [OPTIONS] <KEY>"
    },
    {
      "about": "Install the latest hall from main; does nothing when it's current",
      "args": [
        {
          "default": "false",
          "help": "Only say whether an update is available; install nothing",
          "name": "check",
          "required": false,
          "syntax": "--check",
          "takes_value": false
        },
        {
          "default": "https://github.com/tiagocolombo/hallmark.git",
          "help": "The git repository to install from",
          "name": "source",
          "required": false,
          "syntax": "--source <source>",
          "takes_value": true
        },
        {
          "default": "main",
          "help": "The branch whose latest commit is installed",
          "name": "branch",
          "required": false,
          "syntax": "--branch <branch>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Don't refresh the Claude Code plugin or restart the daemon afterwards",
          "name": "no_setup",
          "required": false,
          "syntax": "--no-setup",
          "takes_value": false
        }
      ],
      "name": "update",
      "schema": "hall schema update",
      "usage": "hall update [OPTIONS]"
    },
    {
      "about": "Run the review loop in the background for every registered repo",
      "args": [],
      "name": "daemon",
      "schema": "hall schema daemon",
      "usage": "hall daemon [OPTIONS] <COMMAND>"
    },
    {
      "about": "Start the daemon in the background",
      "args": [
        {
          "default": "false",
          "help": "Also start it at login (launchd, systemd, Task Scheduler)",
          "name": "at_login",
          "required": false,
          "syntax": "--at-login",
          "takes_value": false
        }
      ],
      "name": "daemon start",
      "schema": "hall schema daemon",
      "usage": "hall daemon start [OPTIONS]"
    },
    {
      "about": "Stop the daemon",
      "args": [
        {
          "default": "false",
          "help": "Also remove the login service",
          "name": "at_login",
          "required": false,
          "syntax": "--at-login",
          "takes_value": false
        }
      ],
      "name": "daemon stop",
      "schema": "hall schema daemon",
      "usage": "hall daemon stop [OPTIONS]"
    },
    {
      "about": "Is it running, paused, and what is it doing?",
      "args": [],
      "name": "daemon status",
      "schema": "hall schema daemon",
      "usage": "hall daemon status [OPTIONS]"
    },
    {
      "about": "Lift a pause now (a rate limit or the daily budget), before its time",
      "args": [],
      "name": "daemon resume",
      "schema": "hall schema daemon",
      "usage": "hall daemon resume [OPTIONS]"
    },
    {
      "about": "Run the loop in the foreground (what `start` launches)",
      "args": [
        {
          "default": "false",
          "help": "One pass over the repos, then exit",
          "name": "once",
          "required": false,
          "syntax": "--once",
          "takes_value": false
        },
        {
          "help": "Only these workers (comma-separated): watchman, resume, assayer, fixer, shipper, delivery, delivery-watch, ci, librarian, notify",
          "name": "only",
          "required": false,
          "syntax": "--only <only>",
          "takes_value": true
        },
        {
          "help": "Only this repository (default: every registered repo; with --once, the current one)",
          "name": "repo",
          "required": false,
          "syntax": "--repo <repo>",
          "takes_value": true
        }
      ],
      "name": "daemon run",
      "schema": "hall schema daemon",
      "usage": "hall daemon run [OPTIONS]"
    },
    {
      "about": "Claim the next piece of work for a role, with a lease (agents)",
      "args": [
        {
          "name": "role",
          "required": true,
          "syntax": "--role <role>",
          "takes_value": true,
          "values": [
            "assayer",
            "fixer",
            "shipper"
          ]
        },
        {
          "help": "Claim this item rather than the next one",
          "name": "item",
          "required": false,
          "syntax": "--item <item>",
          "takes_value": true
        },
        {
          "help": "Who is claiming (default: HALL_ACTOR and the process ID)",
          "name": "holder",
          "required": false,
          "syntax": "--holder <holder>",
          "takes_value": true
        },
        {
          "default": "30m",
          "help": "How long the lease lasts, such as 30m",
          "name": "ttl",
          "required": false,
          "syntax": "--ttl <ttl>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Release the lease on --item instead of claiming",
          "name": "release",
          "required": false,
          "syntax": "--release",
          "takes_value": false
        }
      ],
      "name": "next",
      "schema": "hall schema next",
      "usage": "hall next [OPTIONS] --role <ROLE>"
    },
    {
      "about": "Open findings and failing checks for an item (fixer)",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Include fixed and withdrawn findings",
          "name": "all",
          "required": false,
          "syntax": "--all",
          "takes_value": false
        }
      ],
      "name": "findings",
      "schema": "hall schema findings",
      "usage": "hall findings [OPTIONS] [ID]"
    },
    {
      "about": "Record which findings a commit fixes, or dispute one (fixer)",
      "args": [
        {
          "help": "Findings the committed HEAD fixes (F1 F2 …). None when only failing checks were fixed",
          "name": "ids",
          "required": false,
          "syntax": "<ids>",
          "takes_value": true
        },
        {
          "name": "item",
          "required": false,
          "syntax": "--item <item>",
          "takes_value": true
        },
        {
          "help": "A finding you dispute instead of fixing (repeatable; needs --reason)",
          "name": "dispute",
          "required": false,
          "syntax": "--dispute <dispute>",
          "takes_value": true
        },
        {
          "help": "Why the disputed findings are wrong",
          "name": "reason",
          "required": false,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "fixed",
      "schema": "hall schema fixed",
      "usage": "hall fixed [OPTIONS] [IDS]..."
    },
    {
      "about": "Record a schema-checked verdict for an item in review (assayer)",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "The verdict JSON (plugin/schemas/verdict.json); `-` reads stdin",
          "name": "file",
          "required": true,
          "syntax": "--file <file>",
          "takes_value": true
        },
        {
          "help": "The reviewed commit (default: the item's frozen commit)",
          "name": "sha",
          "required": false,
          "syntax": "--sha <sha>",
          "takes_value": true
        }
      ],
      "name": "verdict",
      "schema": "hall schema verdict",
      "usage": "hall verdict [OPTIONS] --file <FILE> [ID]"
    },
    {
      "about": "Merge a parallel part (child item) into its parent's branch",
      "args": [
        {
          "help": "The child item (default: the current worktree's item)",
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Keep the child's worktree on disk",
          "name": "keep_worktree",
          "required": false,
          "syntax": "--keep-worktree",
          "takes_value": false
        }
      ],
      "name": "merge",
      "schema": "hall schema merge",
      "usage": "hall merge [OPTIONS] [ID]"
    },
    {
      "about": "Closed and dropped items, and why things were rejected",
      "args": [
        {
          "default": "false",
          "help": "Only items with at least one rejected review",
          "name": "rejected",
          "required": false,
          "syntax": "--rejected",
          "takes_value": false
        },
        {
          "help": "Only findings under this lens, such as security or correctness",
          "name": "lens",
          "required": false,
          "syntax": "--lens <lens>",
          "takes_value": true
        },
        {
          "help": "Only items that ended within this long, such as 7d",
          "name": "since",
          "required": false,
          "syntax": "--since <since>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Include items that are still open",
          "name": "all",
          "required": false,
          "syntax": "--all",
          "takes_value": false
        },
        {
          "name": "limit",
          "required": false,
          "syntax": "--limit <limit>",
          "takes_value": true
        }
      ],
      "name": "history",
      "schema": "hall schema history",
      "usage": "hall history [OPTIONS]"
    },
    {
      "about": "An item's whole record as Markdown",
      "args": [
        {
          "name": "id",
          "required": false,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "help": "Write to this file instead of the item's journal directory",
          "name": "out",
          "required": false,
          "syntax": "--out <out>",
          "takes_value": true
        }
      ],
      "name": "export",
      "schema": "hall schema export",
      "usage": "hall export [OPTIONS] [ID]"
    },
    {
      "about": "Show or set the budget caps, with today's spend",
      "args": [
        {
          "help": "Set a cap in .hallmark.toml, such as daily=4M, per_item=800k, review.max_usd=3, review.daily=2M (repeatable)",
          "name": "set",
          "required": false,
          "syntax": "--set <set>",
          "takes_value": true
        },
        {
          "help": "Let the loop go past the daily budget today without changing it: today's cap becomes `daily` plus this many tokens (default: another `daily`), and a daily-budget pause lifts now. Repeating it with the same amount changes nothing; it ends at 00:00 UTC",
          "name": "grant",
          "required": false,
          "syntax": "--grant <grant>",
          "takes_value": true
        },
        {
          "help": "Why, for the journal (with --grant)",
          "name": "reason",
          "required": false,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "budget",
      "schema": "hall schema budget",
      "usage": "hall budget [OPTIONS]"
    },
    {
      "about": "Notifications: `hall notify test` sends one to every channel",
      "args": [],
      "name": "notify",
      "schema": "hall schema notify",
      "usage": "hall notify [OPTIONS] <COMMAND>"
    },
    {
      "about": "Send a test notification to every configured channel",
      "args": [
        {
          "help": "Only this channel: desktop, phone, slack",
          "name": "channel",
          "required": false,
          "syntax": "--channel <channel>",
          "takes_value": true
        }
      ],
      "name": "notify test",
      "schema": "hall schema notify",
      "usage": "hall notify test [OPTIONS]"
    },
    {
      "about": "One line for Claude Code's status line (reads its JSON on stdin)",
      "args": [],
      "name": "statusline",
      "schema": "hall schema statusline",
      "usage": "hall statusline [OPTIONS]"
    },
    {
      "about": "The Library: learnings from past reviews",
      "args": [],
      "name": "library",
      "schema": "hall schema library",
      "usage": "hall library [OPTIONS] <COMMAND>"
    },
    {
      "about": "Search the repo's learnings",
      "args": [
        {
          "name": "query",
          "required": true,
          "syntax": "<query>",
          "takes_value": true
        },
        {
          "default": "10",
          "name": "limit",
          "required": false,
          "syntax": "--limit <limit>",
          "takes_value": true
        },
        {
          "help": "Only this kind: rule, false-positive, map, decision",
          "name": "kind",
          "required": false,
          "syntax": "--kind <kind>",
          "takes_value": true
        },
        {
          "default": "false",
          "help": "Include proposed learnings, not only accepted ones",
          "name": "proposed",
          "required": false,
          "syntax": "--proposed",
          "takes_value": false
        }
      ],
      "name": "library search",
      "schema": "hall schema library",
      "usage": "hall library search [OPTIONS] <QUERY>"
    },
    {
      "about": "List proposed learnings, or accept and reject them",
      "args": [
        {
          "help": "Learnings to accept (L-0001 …); a retired one is reinstated",
          "name": "accept",
          "required": false,
          "syntax": "--accept <accept>",
          "takes_value": true
        },
        {
          "help": "Learnings to reject; an update gives back the version it replaced",
          "name": "reject",
          "required": false,
          "syntax": "--reject <reject>",
          "takes_value": true
        },
        {
          "name": "reason",
          "required": false,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "library review",
      "schema": "hall schema library",
      "usage": "hall library review [OPTIONS]"
    },
    {
      "about": "Retire a learning, keeping its history",
      "args": [
        {
          "name": "id",
          "required": true,
          "syntax": "<id>",
          "takes_value": true
        },
        {
          "name": "reason",
          "required": true,
          "syntax": "--reason <reason>",
          "takes_value": true
        }
      ],
      "name": "library retire",
      "schema": "hall schema library",
      "usage": "hall library retire [OPTIONS] --reason <REASON> <ID>"
    },
    {
      "about": "Run the librarian on one closed or escalated item now",
      "args": [
        {
          "name": "id",
          "required": true,
          "syntax": "<id>",
          "takes_value": true
        }
      ],
      "name": "library distill",
      "schema": "hall schema library",
      "usage": "hall library distill [OPTIONS] <ID>"
    },
    {
      "about": "Add learnings to the local Library: committed ones, a directory or an export",
      "args": [
        {
          "help": "A directory of learning files or an export file. Default: `[library] dir` (.hallmark/knowledge) on the base branch",
          "name": "source",
          "required": false,
          "syntax": "<source>",
          "takes_value": true
        }
      ],
      "name": "library import",
      "schema": "hall schema library",
      "usage": "hall library import [OPTIONS] [SOURCE]"
    },
    {
      "about": "Write every learning in the local Library to one JSON file",
      "args": [
        {
          "help": "The file to write. Without it, the reply carries the learnings",
          "name": "out",
          "required": false,
          "syntax": "--out <out>",
          "takes_value": true
        }
      ],
      "name": "library export",
      "schema": "hall schema library",
      "usage": "hall library export [OPTIONS]"
    },
    {
      "about": "Skill packs by other authors, with their credits: which of Hallmark's roles follow them here. `hall extensions enable mattpocock` turns one on",
      "args": [],
      "name": "extensions",
      "schema": "hall schema extensions",
      "usage": "hall extensions [OPTIONS] [COMMAND]"
    },
    {
      "about": "Every extension, its credits, and the roles it serves here (the default)",
      "args": [],
      "name": "extensions list",
      "schema": "hall schema extensions",
      "usage": "hall extensions list [OPTIONS]"
    },
    {
      "about": "Turn an extension on for every role it serves, or only for --role",
      "args": [
        {
          "help": "The extension: `hall extensions` lists them",
          "name": "name",
          "required": true,
          "syntax": "<name>",
          "takes_value": true
        },
        {
          "help": "Only this role (repeatable): planner, developer, reviewer, fixer",
          "name": "roles",
          "required": false,
          "syntax": "--role <roles>",
          "takes_value": true,
          "values": [
            "planner",
            "developer",
            "reviewer",
            "fixer"
          ]
        }
      ],
      "name": "extensions enable",
      "schema": "hall schema extensions",
      "usage": "hall extensions enable [OPTIONS] <NAME>"
    },
    {
      "about": "Turn an extension off for every role, or only for --role",
      "args": [
        {
          "help": "The extension",
          "name": "name",
          "required": true,
          "syntax": "<name>",
          "takes_value": true
        },
        {
          "help": "Only this role (repeatable)",
          "name": "roles",
          "required": false,
          "syntax": "--role <roles>",
          "takes_value": true,
          "values": [
            "planner",
            "developer",
            "reviewer",
            "fixer"
          ]
        }
      ],
      "name": "extensions disable",
      "schema": "hall schema extensions",
      "usage": "hall extensions disable [OPTIONS] <NAME>"
    },
    {
      "about": "An extension's credits and license, or one of its skills as agents read it",
      "args": [
        {
          "help": "The extension",
          "name": "name",
          "required": true,
          "syntax": "<name>",
          "takes_value": true
        },
        {
          "help": "The skill to print",
          "name": "skill",
          "required": false,
          "syntax": "<skill>",
          "takes_value": true
        }
      ],
      "name": "extensions show",
      "schema": "hall schema extensions",
      "usage": "hall extensions show [OPTIONS] <NAME> [SKILL]"
    },
    {
      "about": "Everything the Claude Code heads-up display shows, in one call",
      "args": [
        {
          "help": "The Claude Code session, for its item when the directory has none",
          "name": "session",
          "required": false,
          "syntax": "--session <session>",
          "takes_value": true
        },
        {
          "default": "6",
          "help": "Lines of the daemon's Live log to include",
          "name": "lines",
          "required": false,
          "syntax": "--lines <lines>",
          "takes_value": true
        }
      ],
      "name": "hud",
      "schema": "hall schema hud",
      "usage": "hall hud [OPTIONS]"
    }
  ],
  "contract": [
    "Output is JSON when stdout is not a terminal; --json forces it.",
    "Every reply has `next`: the commands that make sense now.",
    "Errors are {\"error\":{\"code\",\"message\",\"next\"}} with a documented exit code.",
    "Commands never prompt (only `hall setup --interactive` asks, on a terminal); destructive ones need explicit flags such as --reason.",
    "Commands are idempotent: repeating one returns the current result.",
    "Inside an item's worktree the item ID is optional.",
    "`hall schema <command>` prints the JSON Schema of a command's output."
  ],
  "error_codes": [
    {
      "code": "USAGE",
      "exit": 2
    },
    {
      "code": "NOT_A_REPO",
      "exit": 3
    },
    {
      "code": "NOT_INITIALIZED",
      "exit": 3
    },
    {
      "code": "ITEM_NOT_FOUND",
      "exit": 3
    },
    {
      "code": "NO_ITEM",
      "exit": 3
    },
    {
      "code": "QUESTION_NOT_FOUND",
      "exit": 3
    },
    {
      "code": "WRONG_STATE",
      "exit": 4
    },
    {
      "code": "ITEM_IN_REVIEW",
      "exit": 4
    },
    {
      "code": "DIRTY_WORKTREE",
      "exit": 4
    },
    {
      "code": "ALREADY_ANSWERED",
      "exit": 4
    },
    {
      "code": "GATE_DENIED",
      "exit": 5
    },
    {
      "code": "CHECKS_FAILED",
      "exit": 6
    },
    {
      "code": "CLAIMED",
      "exit": 7
    },
    {
      "code": "CHILDREN_OPEN",
      "exit": 4
    },
    {
      "code": "MERGE_CONFLICT",
      "exit": 4
    },
    {
      "code": "BUDGET_EXCEEDED",
      "exit": 4
    },
    {
      "code": "INVALID_VERDICT",
      "exit": 2
    },
    {
      "code": "RUN_FAILED",
      "exit": 1
    },
    {
      "code": "GH_UNAVAILABLE",
      "exit": 1
    },
    {
      "code": "COMMAND_FAILED",
      "exit": 1
    },
    {
      "code": "INTERNAL",
      "exit": 1
    }
  ],
  "exit_codes": [
    {
      "code": 0,
      "meaning": "ok"
    },
    {
      "code": 1,
      "meaning": "internal error or a failed external command"
    },
    {
      "code": 2,
      "meaning": "bad arguments"
    },
    {
      "code": 3,
      "meaning": "not found (repo, item, question)"
    },
    {
      "code": 4,
      "meaning": "not allowed in the item's current state"
    },
    {
      "code": 5,
      "meaning": "denied by the gate"
    },
    {
      "code": 6,
      "meaning": "checks failed"
    },
    {
      "code": 7,
      "meaning": "claimed by another agent"
    }
  ],
  "name": "hall",
  "next": [
    "hall schema <command>",
    "hall status"
  ],
  "version": "[version]"
}
