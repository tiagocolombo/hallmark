Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1440
Set Height 760
Set Padding 18
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 0
Set TypingSpeed 70ms
Set Theme { "name": "Hall Light", "black": "#1b1c1d", "red": "#cf222e", "green": "#1a7f37", "yellow": "#9a6700", "blue": "#0969da", "magenta": "#8250df", "cyan": "#1b7c83", "white": "#57606a", "brightBlack": "#6e7175", "brightRed": "#a40e26", "brightGreen": "#116329", "brightYellow": "#7d4e00", "brightBlue": "#0550ae", "brightMagenta": "#6639ba", "brightCyan": "#136061", "brightWhite": "#3a3c3e", "background": "#fbfbfa", "foreground": "#1b1c1d", "selection": "#ece6d6", "cursor": "#9a6b12" }
