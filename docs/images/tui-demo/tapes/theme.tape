Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1440
Set Height 760
Set Padding 18
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 0
Set TypingSpeed 70ms
Set Theme { "name": "Hall", "black": "#1d2224", "red": "#f0806f", "green": "#74c99b", "yellow": "#e0b252", "blue": "#79acd8", "magenta": "#b394e0", "cyan": "#6cc5c0", "white": "#d7dcdb", "brightBlack": "#7e8a8d", "brightRed": "#f59a8c", "brightGreen": "#8fd8b0", "brightYellow": "#f3d38a", "brightBlue": "#9cc4e6", "brightMagenta": "#c9b0ea", "brightCyan": "#8fd8d3", "brightWhite": "#ffffff", "background": "#111517", "foreground": "#d7dcdb", "selection": "#1f2a2f", "cursor": "#e0b252" }
